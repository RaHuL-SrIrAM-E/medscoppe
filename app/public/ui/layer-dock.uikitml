<style>
  .dock {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2;
    padding-left: 1.6;
    padding-right: 1.6;
    padding-top: 1.4;
    padding-bottom: 1.4;
    background-color: #0e1622;
    border-color: #2a3b52;
    border-width: 0.2;
    border-radius: 5;
  }
  .chips {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.2;
  }
  .credit {
    font-size: 1.5;
    color: #8fa6bd;
    text-align: center;
    width: 56;
  }
  .chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 3;
    padding-right: 3;
    padding-top: 1.6;
    padding-bottom: 1.6;
    background-color: #142033;
    border-color: #2a3b52;
    border-width: 0.2;
    border-radius: 3.5;
    cursor: pointer;
  }
  .label {
    font-size: 2.4;
    font-weight: 600;
    color: #cfe3f5;
  }
</style>
<div class="dock" id="dock">
  <div class="chips" id="chips">
  <button class="chip" id="chip-respiratory"><span class="label" id="label-respiratory">Respiratory</span></button>
  <button class="chip" id="chip-skeletal"><span class="label" id="label-skeletal">Skeleton</span></button>
  <button class="chip" id="chip-surface"><span class="label" id="label-surface">Body</span></button>
  <button class="chip" id="chip-reset"><span class="label" id="label-reset">Reset</span></button>
  </div>
  <span class="credit" id="credit">Anatomy: BodyParts3D, (c) The Database Center for Life Science licensed under CC Attribution 4.0 International. Adapted: merged, decimated, lung lobe volumes are illustrative approximations.</span>
</div>
