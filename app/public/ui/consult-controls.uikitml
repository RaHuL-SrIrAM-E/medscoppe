<style>
  .panel {
    display: flex;
    flex-direction: column;
    gap: 1.2;
    width: 34;
    padding-left: 2.2;
    padding-right: 2.2;
    padding-top: 2;
    padding-bottom: 2;
    background-color: #0e1622;
    border-color: #2a3b52;
    border-width: 0.2;
    border-radius: 4;
  }
  .data { font-size: 1.8; font-weight: 700; color: #ffb454; }
  .extraction { font-size: 1.8; font-weight: 700; color: #ffb454; }
  .detail { font-size: 1.5; color: #9db3c9; }
  .statusrow { display: flex; flex-direction: row; align-items: center; gap: 1.6; margin-top: 0.4; }
  .state { font-size: 2.6; font-weight: 700; color: #cfe3f5; }
  .busy { font-size: 1.8; color: #7cf2d4; }
  .row { display: flex; flex-direction: row; align-items: center; gap: 1.4; }
  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 17;
    height: 7.4;
    padding-left: 2.4;
    padding-right: 2.4;
    background-color: #142033;
    border-color: #7cf2d4;
    border-width: 0.25;
    border-radius: 3.5;
    cursor: pointer;
  }
  .btn-secondary { border-color: #2a3b52; }
  .btn-label { font-size: 2.6; font-weight: 700; color: #e8f3ff; }
  .caption { font-size: 2; color: #dbe8f5; }
  .error { font-size: 1.8; font-weight: 600; color: #ff8a7a; }
  .notice { font-size: 1.7; color: #f2c14e; }
</style>
<div class="panel" id="panel">
  <span class="data" id="data-label">SCRIPTED CONSULTATION - SYNTHETIC DATA</span>
  <span class="extraction" id="extraction-label">EXTRACTION: checking backend...</span>
  <span class="detail" id="extraction-detail">detail</span>
  <div class="statusrow" id="statusrow">
    <span class="state" id="state-label">READY</span>
    <span class="busy" id="busy-label">Extracting...</span>
  </div>
  <div class="row" id="buttons">
    <button class="btn" id="consult-btn-primary"><span class="btn-label" id="consult-btn-primary-label">Start</span></button>
    <button class="btn btn-secondary" id="consult-btn-end"><span class="btn-label" id="consult-btn-end-label">End</span></button>
  </div>
  <div class="row" id="retry-row">
    <button class="btn btn-secondary" id="consult-btn-retry"><span class="btn-label" id="consult-btn-retry-label">Retry extraction</span></button>
  </div>
  <span class="caption" id="caption">caption</span>
  <span class="error" id="error">error</span>
  <span class="notice" id="notice">notice</span>
</div>
