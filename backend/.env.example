# Copy to .env. Never commit .env.
# Gemini is optional: the frontend and scripted consultation work without it.
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://localhost:8081

# Consultation extraction: auto | gemini | replay. "auto" uses Gemini when GEMINI_API_KEY and GEMINI_MODEL are
# both set, otherwise a clearly labelled recorded-replay fixture. List the models your key can use with:
#   .venv/bin/python scripts/list_models.py
EXTRACTION_PROVIDER=auto
GEMINI_TIMEOUT_S=20
# Synthetic data only. Leave false.
ALLOW_REAL_DATA=false
