      "type": "string"
     },
     "speaker": {
      "$ref": "#/$defs/Speaker"
     },
     "speaker_basis": {
      "$ref": "#/$defs/SpeakerBasis"
     },
     "text": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     },
     "start_ms": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Start Ms"
     },
     "end_ms": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "End Ms"
     }
    },
    "required": [
     "id",
     "speaker",
     "speaker_basis",
     "text"
    ],
    "title": "Utterance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "schema_version": {
    "const": "1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "consultation_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Consultation Id",
    "type": "string"
   },
   "data_classification": {
    "description": "Must be \"SYNTHETIC\". Anything else is refused.",
    "title": "Data Classification",
    "type": "string"
   },
   "utterances": {
    "items": {
     "$ref": "#/$defs/Utterance"
    },
    "maxItems": 12,
    "minItems": 1,
    "title": "Utterances",
    "type": "array"
   },
   "context_utterances": {
    "items": {
     "$ref": "#/$defs/Utterance"
    },
    "maxItems": 30,
    "title": "Context Utterances",
    "type": "array"
   },
   "known_observations": {
    "items": {
     "$ref": "#/$defs/ObservationRef"
    },
    "maxItems": 50,
    "title": "Known Observations",
    "type": "array"
   }
  },
  "required": [
   "schema_version",
   "consultation_id",
   "data_classification",
   "utterances"
  ],
  "title": "ExtractRequest",
  "type": "object"
