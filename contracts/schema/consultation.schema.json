{
 "schema_version": "1.0",
 "extract_request": {
  "$defs": {
   "Attributes": {
    "additionalProperties": false,
    "description": "Everything here is null/empty unless the speaker actually said it. Null means NOT STATED.",
    "properties": {
     "onset": {
      "anyOf": [
       {
        "$ref": "#/$defs/Onset"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "duration": {
      "anyOf": [
       {
        "$ref": "#/$defs/Duration"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "severity": {
      "anyOf": [
       {
        "$ref": "#/$defs/Severity"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "character_over_time": {
      "items": {
       "$ref": "#/$defs/QualityPhase"
      },
      "maxItems": 4,
      "title": "Character Over Time",
      "type": "array"
     },
     "context": {
      "items": {
       "$ref": "#/$defs/Context"
      },
      "maxItems": 3,
      "title": "Context",
      "type": "array"
     }
    },
    "title": "Attributes",
    "type": "object"
   },
   "Character": {
    "enum": [
     "DRY",
     "PRODUCTIVE"
    ],
    "title": "Character",
    "type": "string"
   },
   "Context": {
    "enum": [
     "EXERTION",
     "REST",
     "NIGHT"
    ],
    "title": "Context",
    "type": "string"
   },
   "Duration": {
    "additionalProperties": false,
    "properties": {
     "value": {
      "maximum": 365,
      "minimum": 1,
      "title": "Value",
      "type": "integer"
     },
     "unit": {
      "$ref": "#/$defs/DurationUnit"
     },
     "approximate": {
      "title": "Approximate",
      "type": "boolean"
     },
     "text": {
      "description": "The words the speaker used, verbatim.",
      "maxLength": 60,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "value",
     "unit",
     "approximate",
     "text"
    ],
    "title": "Duration",
    "type": "object"
   },
   "DurationUnit": {
    "enum": [
     "HOURS",
     "DAYS",
     "WEEKS",
     "MONTHS"
    ],
    "title": "DurationUnit",
    "type": "string"
   },
   "ObservationKind": {
    "enum": [
     "SYMPTOM",
     "PATIENT_STATED_CONDITION"
    ],
    "title": "ObservationKind",
    "type": "string"
   },
   "ObservationRef": {
    "additionalProperties": false,
    "description": "What the client tells the server about observations it already holds (no quotes).",
    "properties": {
     "id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Id",
      "type": "string"
     },
     "kind": {
      "$ref": "#/$defs/ObservationKind"
     },
     "symptom": {
      "anyOf": [
       {
        "$ref": "#/$defs/SymptomCode"
       },
       {
        "type": "null"
       }
      ]
     },
     "label": {
      "anyOf": [
       {
        "maxLength": 40,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Label"
     },
     "status": {
      "$ref": "#/$defs/Status"
     },
     "source": {
      "$ref": "#/$defs/Source"
     },
     "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
     },
     "attributes": {
      "$ref": "#/$defs/Attributes"
     }
    },
    "required": [
     "id",
     "kind",
     "symptom",
     "status",
     "source",
     "revision",
     "attributes"
    ],
    "title": "ObservationRef",
    "type": "object"
   },
   "Onset": {
    "enum": [
     "SUDDEN",
     "GRADUAL"
    ],
    "title": "Onset",
    "type": "string"
   },
   "Phase": {
    "enum": [
     "INITIAL",
     "CURRENT"
    ],
    "title": "Phase",
    "type": "string"
   },
   "QualityPhase": {
