    "enum": [
     "PATIENT_REPORTED",
     "DOCTOR_CONFIRMED",
     "DOCTOR_OBSERVED",
     "SYSTEM_DERIVED"
    ],
    "title": "Source",
    "type": "string"
   },
   "Speaker": {
    "enum": [
     "DOCTOR",
     "PATIENT",
     "UNATTRIBUTED"
    ],
    "title": "Speaker",
    "type": "string"
   },
   "SpeakerBasis": {
    "description": "How the speaker label was obtained. There is deliberately no automatic-diarisation value.",
    "enum": [
     "SCRIPTED",
     "MANUAL_SELECTION",
     "UNVERIFIED"
    ],
    "title": "SpeakerBasis",
    "type": "string"
   },
   "Status": {
    "enum": [
     "PRESENT",
     "ABSENT",
     "UNKNOWN",
     "UNRESOLVED"
    ],
    "title": "Status",
    "type": "string"
   },
   "SymptomCode": {
    "enum": [
     "COUGH",
     "FEVER",
     "DYSPNOEA",
     "CHEST_PAIN",
     "WHEEZE",
     "HAEMOPTYSIS",
     "SORE_THROAT",
     "FATIGUE",
     "NASAL_CONGESTION",
     "HEADACHE",
     "OTHER"
    ],
    "title": "SymptomCode",
    "type": "string"
   },
   "Utterance": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
